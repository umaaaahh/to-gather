rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins are the accounts listed in admins/{uid}, added by hand in the
    // Firebase console (which skips these rules). Not "any non-anonymous
    // sign-in": anyone with the web API key can make their own email/password
    // account, but nothing in the app can add them to admins. storage.rules
    // checks the same list.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A download URL for one of our own uploads in drawings/{zone}/ (see
    // saveDrawing in drawingsStore.js), so a drawing doc can't point the
    // street at an image hosted anywhere else.
    function isDrawingUrl(url, zone) {
      return url is string
        && url.size() < 2000
        && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/to-gather-54dd7[.]firebasestorage[.]app/o/drawings%2F'
          + zone + '%2F[A-Za-z0-9_-]+[.]png[?].*');
    }

    // A Google Books / Play address. The host has to end right after the
    // country part, so books.google.evil.com doesn't pass. Mirrors
    // isGoogleUrl in Bookshelf.jsx.
    function isGoogleUrl(url, hosts) {
      return url.size() < 2000
        && url.matches('https://(' + hosts + ')[.]google[.](com|com[.][a-z]{2}|co[.][a-z]{2}|[a-z]{2})/.*');
    }

    function signedIn() {
      return request.auth != null;
    }

    function bookPath(bookId) {
      return /databases/$(database)/documents/shelfBooks/$(bookId);
    }

    // This visitor's vote on a book (see shelfStore.js for the id scheme).
    function myVotePath(bookId) {
      return /databases/$(database)/documents/shelfVotes/$(request.auth.uid + '_' + bookId);
    }

    // Console-only: see isAdmin().
    match /admins/{uid} {
      allow read, write: if false;
    }

    match /drawings/{drawingId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['zone', 'url', 'path', 'thumbUrl', 'thumbPath', 'createdAt'])
        && request.resource.data.zone in ['tree', 'stem', 'free']
        && isDrawingUrl(request.resource.data.url, request.resource.data.zone)
        && isDrawingUrl(request.resource.data.thumbUrl, request.resource.data.zone)
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // The Shelf. A book's `votes` count only ever moves by one, in the same
    // batch as this visitor's vote doc being created or deleted, so the count
    // always matches the votes and nobody can vote twice.
    match /shelfBooks/{bookId} {
      allow read: if true;

      allow create: if signedIn()
        && bookId.matches('[A-Za-z0-9_-]{1,64}')
        && request.resource.data.keys().hasOnly(['title', 'authors', 'cover', 'link', 'votes', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'authors', 'cover', 'link', 'votes', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.authors is string
        && request.resource.data.authors.size() <= 200
        && request.resource.data.cover is string
        && (request.resource.data.cover == ''
          || isGoogleUrl(request.resource.data.cover, 'books'))
        && request.resource.data.link is string
        && (request.resource.data.link == ''
          || isGoogleUrl(request.resource.data.link, 'books|play'))
        && request.resource.data.votes == 1
        && request.resource.data.createdAt == request.time
        && !exists(myVotePath(bookId))
        && existsAfter(myVotePath(bookId));

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && ((request.resource.data.votes == resource.data.votes + 1
            && !exists(myVotePath(bookId))
            && existsAfter(myVotePath(bookId)))
          || (request.resource.data.votes == resource.data.votes - 1
            && exists(myVotePath(bookId))
            && !existsAfter(myVotePath(bookId))));

      allow delete: if isAdmin();
    }

    match /shelfVotes/{voteId} {
      // Only your own votes, so the shelf can show which books you've voted
      // for. The admin reads them all, to clear a book's votes when deleting it.
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'bookId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bookId is string
        && voteId == request.auth.uid + '_' + request.resource.data.bookId
        && request.resource.data.createdAt == request.time
        && existsAfter(bookPath(request.resource.data.bookId))
        && getAfter(bookPath(request.resource.data.bookId)).data.votes
          == (exists(bookPath(request.resource.data.bookId))
            ? get(bookPath(request.resource.data.bookId)).data.votes + 1
            : 1);

      allow update: if false;

      allow delete: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && getAfter(bookPath(resource.data.bookId)).data.votes
            == get(bookPath(resource.data.bookId)).data.votes - 1);
    }

    match /shelfNotes/{noteId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['bookId', 'text', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 140
        && request.resource.data.bookId is string
        && existsAfter(bookPath(request.resource.data.bookId))
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
