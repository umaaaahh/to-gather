rules_version = '2';

service firebase.storage {
  // The accounts listed in Firestore's admins/{uid}, same as isAdmin() in
  // firestore.rules.
  function isAdmin() {
    return request.auth != null
      && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
  }

  match /b/{bucket}/o {
    match /drawings/{zone}/{fileName} {
      allow read: if true;

      // New files only: a drawing's file never changes after upload, and its
      // path is public in Firestore, so allowing overwrites would let anyone
      // swap out a drawing already on the street.
      allow create: if resource == null
        && zone in ['tree', 'stem', 'free']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/png';

      allow delete: if isAdmin();
    }
  }
}
