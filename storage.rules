rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /drawings/{zone}/{fileName} {
      allow read: if true;

      allow write: if zone in ['tree', 'stem', 'free']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/png';

      // admin-only (Uma's Firebase Auth account). Shelf visitors are signed in
      // anonymously, so they're ruled out explicitly.
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
